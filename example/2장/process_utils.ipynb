    "def calc_defect_rate(defect_count, total_count):\n",
    "    \"\"\"불량률(%)을 계산한다.\"\"\"\n",
    "    if total_count == 0:\n",
    "        return 0.0\n",
    "    return defect_count / total_count * 100"
   ]
